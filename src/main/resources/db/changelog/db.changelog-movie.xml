<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-movie-table" author="imazolevska">
        <createTable tableName="movie">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tmdb_id" type="INT"/>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="release_year" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="REAL" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="poster_path" type="VARCHAR(255)"/>
            <column name="director_id" type="INT">
                <constraints foreignKeyName="fk_movie_director" referencedTableName="director"
                             referencedColumnNames="id" deleteCascade="true"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="create-movie-director-index" author="imazolevska">
        <createIndex tableName="movie" indexName="idx_movie_director_id">
            <column name="director_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>